generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WalletStatus {
  ACTIVE
  FROZEN
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  TRANSFER
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAW
  TRANSFER
  RESERVATION
  RELEASE
  ADJUSTMENT
}

enum Direction {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum DepositStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum BankName {
  SBI
  HDFC
  ICICI
  AXIS
  KOTAK
  PNB
}

enum StockCategoryKey {
  NIFTY_50
  SENSEX
  BANK_NIFTY
  MID_CAP
  SMALL_CAP
  LARGE_CAP
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bankAccounts  BankAccount[]
  refreshTokens RefreshToken[]
  wallet        Wallet?
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id                  String        @id @default(uuid())
  cashBalance         Decimal       @default(0) @db.Decimal(18, 2)
  usedMargin          Decimal       @default(0) @db.Decimal(18, 2)
  reservedWithdrawals Decimal       @default(0) @db.Decimal(18, 2)
  status              WalletStatus  @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  userId              String        @unique
  deposits            Deposit[]
  ledgerEntries       LedgerEntry[]
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals         Withdrawal[]
}

model Transaction {
  id              String            @id @default(uuid())
  amount          Decimal           @db.Decimal(18, 2)
  transactionType TransactionType
  referenceId     String            @unique
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deposit         Deposit?
  ledgerEntries   LedgerEntry[]
  withdrawal      Withdrawal?
}

model LedgerEntry {
  id            String          @id @default(uuid())
  entryType     LedgerEntryType
  amount        Decimal         @db.Decimal(18, 2)
  direction     Direction
  balanceAfter  Decimal         @db.Decimal(18, 2)
  walletId      String
  transactionId String
  referenceId   String?
  createdAt     DateTime        @default(now())
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  wallet        Wallet          @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@index([referenceId])
}

model Withdrawal {
  id             String           @id @default(uuid())
  amount         Decimal          @db.Decimal(18, 2)
  reservedAmount Decimal
  status         WithdrawalStatus @default(PENDING)
  idempotencyKey String           @unique
  referenceId    String?          @unique
  failureReason  String?
  requestedAt    DateTime         @default(now())
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  walletId       String
  transactionId  String?          @unique
  bankAccountId  String?
  bankAccount    BankAccount?     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  transaction    Transaction?     @relation(fields: [transactionId], references: [id])
  wallet         Wallet           @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@index([bankAccountId])
}

model Deposit {
  id               String        @id @default(cuid())
  amount           Decimal       @db.Decimal(18, 2)
  status           DepositStatus @default(PENDING)
  referenceId      String?       @unique
  idempotencyKey   String        @unique
  paymentReference String?
  failureReason    String?
  requestedAt      DateTime      @default(now())
  completedAt      DateTime?
  walletId         String
  transactionId    String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  bankAccountId    String?
  bankAccount      BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  transaction      Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet           Wallet        @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([status, createdAt])
  @@index([bankAccountId])
}

model BankAccount {
  id            String       @id @default(cuid())
  bankName      BankName
  accountHolder String
  accountNumber String       @unique
  ifscCode      String
  createdAt     DateTime     @default(now())
  userId        String
  isPrimary     Boolean      @default(false)
  balance       Decimal      @default(0) @db.Decimal(15, 2)
  user          User         @relation(fields: [userId], references: [id])
  deposits      Deposit[]
  withdrawals   Withdrawal[]

  @@index([userId])
}

model Stock {
  id       String  @id @default(uuid())
  name     String
  symbol   String  @unique
  exchange String  @default("NSE")
  sector   String?

  quote      MarketQuote?
  categories StockCategoryMembership[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([sector])
  @@index([exchange, isActive])
}

model MarketQuote {
  id String @id @default(uuid())

  currentPrice  Decimal @db.Decimal(20, 6)
  open          Decimal @db.Decimal(20, 6)
  high          Decimal @db.Decimal(20, 6)
  low           Decimal @db.Decimal(20, 6)
  previousClose Decimal @db.Decimal(20, 6)

  volume        BigInt
  marketCapt    Decimal? @db.Decimal(24, 2)
  peRatio       Decimal? @db.Decimal(12, 4)
  eps           Decimal? @db.Decimal(12, 4)
  dividendYeild Decimal? @db.Decimal(12, 4)

  asOf      DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockId String @unique
  stock   Stock  @relation(fields: [stockId], references: [id])

  @@index([updatedAt])
}

model StockCategory {
  id          String           @id @default(uuid())
  key         StockCategoryKey @unique
  name        String
  description String?

  stocks StockCategoryMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockCategoryMembership {
  id String @id @default(uuid())

  stockId    String
  categoryId String

  stock    Stock         @relation(fields: [stockId], references: [id])
  category StockCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@unique([stockId, categoryId])
  @@index([categoryId])
}

model StockPriceHistory {
  id        String   @id @default(uuid())
  stockId   String
  open      Decimal  @db.Decimal(20, 6)
  high      Decimal  @db.Decimal(20, 6)
  low       Decimal  @db.Decimal(20, 6)
  close     Decimal  @db.Decimal(20, 6)
  volume    BigInt
  interval  String
  timestamp DateTime

  @@index([stockId, interval, timestamp])
}